{
  "id": "pursuittracker",
  "title": "Pursuit Tracker",
  "description": "A top-docked pursuit tracker with personal pursuit selection, permission-aware visibility, and automatic combat hiding.",
  "version": "2.3.2",
  "compatibility": {
    "minimum": "12",
    "verified": "13",
    "maximum": "13"
  },
  "authors": [
    {
      "name": "SaltyJ",
      "url": "https://github.com/KonteiKeisei"
    }
  ],
  "esmodules": [
    "scripts/module.js"
  ],
  "styles": ["styles/pursuit-tracker.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "relationships": {
    "recommends": [
      {
        "id": "tidy5e-sheet",
        "type": "module",
        "reason": "Optional: when enabled, adds a Pursuits tab to character and NPC sheets."
      },
      {
        "id": "calendaria",
        "type": "module",
        "reason": "Optional: enables daily reminder prompts via calendaria.dayChange hook."
      },
      {
        "id": "rest-recovery",
        "type": "module",
        "reason": "Optional: enables daily reminder prompts on long rests with newDay flag."
      }
    ]
  },
  "socket": true,
  "url": "https://github.com/KonteiKeisei/pursuittracker",
  "readme": "https://github.com/KonteiKeisei/pursuittracker/blob/main/README.md",
  "bugs": "https://github.com/KonteiKeisei/pursuittracker/issues",
  "changelog": "https://github.com/KonteiKeisei/pursuittracker/blob/main/CHANGELOG.md",
  "manifest": "https://github.com/KonteiKeisei/pursuittracker/releases/latest/download/module.json",
  "download": "https://github.com/KonteiKeisei/pursuittracker/releases/download/v2.3.2/module.zip"
}
