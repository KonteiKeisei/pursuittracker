{{#if hasTrackers}}
  <ol class="kpursuit-ladder">
    {{#each trackers as |tracker|}}
      <li class="kpursuit-row" data-tracker-id="{{tracker.id}}"
          style="background-image: url('{{tracker.background}}');">
        <div class="kpursuit-shade"></div>
        <span class="kpursuit-name">{{tracker.displayName}}</span>
        <div class="kpursuit-progress">
          <div class="kpursuit-line" aria-hidden="true"></div>
          <ol class="kpursuit-stages">
            {{#each tracker.stagesArray as |stage|}}
              <li class="kpursuit-stage {{#if stage.active}}is-current{{/if}} {{#if stage.passed}}is-passed{{/if}}">
                <button type="button" class="kpursuit-stage-button" data-action="stage" data-stage="{{stage.index}}"
                        aria-label="{{tracker.displayName}} stage {{stage.number}}"
                        {{#unless tracker.canModify}}disabled aria-disabled="true"{{/unless}}>
                  {{stage.number}}
                </button>
              </li>
            {{/each}}
          </ol>
        </div>
      </li>
    {{/each}}
  </ol>
{{/if}}

<button type="button" class="kpursuit-tab" data-action="toggleDrawer"
        aria-label="{{label}}" aria-expanded="{{drawerOpen}}">
  <span>{{label}}</span>
</button>

<section class="kpursuit-drawer" aria-label="Choose pursuits">
  <header class="kpursuit-drawer-header">
    <h3>Choose pursuits</h3>
    <div class="kpursuit-drawer-actions">
      {{#if isGM}}
        <button type="button" class="kpursuit-icon-button" data-action="create" data-tooltip="{{i18n.newTracker}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      {{/if}}
      <button type="button" class="kpursuit-icon-button" data-action="openSettings" data-tooltip="{{i18n.settings}}">
        <i class="fa-solid fa-gear"></i>
      </button>
    </div>
  </header>
  {{#unless hasAvailableTrackers}}<p class="kpursuit-empty">{{i18n.empty}}</p>{{/unless}}
  <ol class="kpursuit-options">
    {{#each availableTrackers as |tracker|}}
      <li data-tracker-id="{{tracker.id}}">
        <label class="kpursuit-option">
          <input type="checkbox" data-action="togglePin" {{#if tracker.personallyVisible}}checked{{/if}}>
          <span>{{tracker.displayName}}</span>
        </label>
        {{#if @root.isGM}}
          <button type="button"
                  class="kpursuit-icon-button kpursuit-option-edit"
                  data-action="edit"
                  data-tooltip="{{@root.i18n.edit}}"
                  aria-label="{{@root.i18n.edit}}: {{tracker.displayName}}">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
        {{/if}}
      </li>
    {{/each}}
  </ol>
</section>
