{{!--
  Tidy 5e Sheets tab content. Mirrors the floating panel's tracker rows
  but with no pull tab and no header — Tidy's tab strip provides those.
  Resizes with the sheet because the outer container is width:100% and
  every inner block uses min-width:0 / flexible flex sizing.
--}}
<section class="pt-tab-root">
  {{#unless pursuittracker.hasTrackers}}
    <p class="pt-empty">{{pursuittracker.i18n.empty}}</p>
  {{/unless}}

  <ol class="pt-list">
    {{#each pursuittracker.trackers as |tracker|}}
      <li class="pt-tracker"
          data-tracker-id="{{tracker.id}}"
          style="background-image: url('{{tracker.background}}'); --pt-denom: {{tracker.denom}};">
        <div class="pt-tracker-overlay"></div>

        <div class="pt-tracker-header">
          <span class="pt-tracker-name">{{tracker.displayName}}</span>
          <div class="pt-tracker-actions">
            {{!-- Stage controls: anyone allowed by canModify (GM, or
                  player-editable for the viewer). --}}
            {{#if tracker.canModify}}
              <button type="button"
                      class="pt-btn pt-btn-icon"
                      data-action="retreat"
                      data-tooltip="{{@root.pursuittracker.i18n.ret}}">
                <i class="fa-solid fa-backward-step"></i>
              </button>
              <button type="button"
                      class="pt-btn pt-btn-icon"
                      data-action="advance"
                      data-tooltip="{{@root.pursuittracker.i18n.adv}}">
                <i class="fa-solid fa-forward-step"></i>
              </button>
            {{/if}}
            {{!-- Management controls: GM-only. The eye icon's state mirrors
                  visibleToPlayers so the GM sees player-visibility at a
                  glance from the sheet tab without bouncing to the panel. --}}
            {{#if @root.pursuittracker.isGM}}
              <button type="button"
                      class="pt-btn pt-btn-icon {{#if tracker.visibleToPlayers}}is-on{{/if}}"
                      data-action="toggleVisibility"
                      data-tooltip="{{@root.pursuittracker.i18n.vis}}">
                <i class="fa-solid {{#if tracker.visibleToPlayers}}fa-eye{{else}}fa-eye-slash{{/if}}"></i>
              </button>
              <button type="button"
                      class="pt-btn pt-btn-icon"
                      data-action="edit"
                      data-tooltip="{{@root.pursuittracker.i18n.edit}}">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button type="button"
                      class="pt-btn pt-btn-icon pt-btn-danger"
                      data-action="delete"
                      data-tooltip="{{@root.pursuittracker.i18n.del}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            {{/if}}
          </div>
        </div>

        <div class="pt-slider pt-slider-horizontal">
          <div class="pt-track" aria-hidden="true"></div>

          <ul class="pt-stages">
            {{#each tracker.stagesArray as |stage|}}
              <li class="pt-stage {{#if stage.active}}is-active{{/if}} {{#if stage.passed}}is-passed{{/if}}"
                  style="--pt-stage-pos: {{stage.index}};">
                <button type="button"
                        class="pt-stage-btn"
                        data-action="stage"
                        data-stage="{{stage.index}}"
                        aria-label="{{tracker.displayName}} stage {{stage.number}}"
                        {{#unless tracker.canModify}}disabled aria-disabled="true"{{/unless}}>
                  {{stage.number}}
                </button>
              </li>
            {{/each}}
          </ul>

        </div>
      </li>
    {{/each}}
  </ol>
</section>
